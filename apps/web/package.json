{
  "name": "web",
  "private": true,
  "version": "1.5.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run version:check && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "version:check": "node ../../scripts/web-version.mjs check",
    "version:patch": "node ../../scripts/web-version.mjs patch",
    "version:minor": "node ../../scripts/web-version.mjs minor",
    "version:major": "node ../../scripts/web-version.mjs major",
    "version:set": "node ../../scripts/web-version.mjs set"
  },
  "dependencies": {
    "@findeat/legal": "*",
    "@findeat/types": "*",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
