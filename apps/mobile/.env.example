# Copy to .env.local and fill in real values. Never commit .env.local.

# Base URL of the FindEat backend API
EXPO_PUBLIC_API_URL=

# Mapbox access token used for maps/geo features
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Client-side GIPHY SDK/API key used by chat and comment GIF search
EXPO_PUBLIC_GIPHY_API_KEY=

# Build variant, e.g. "development" | "preview" | "production"
APP_VARIANT=development
