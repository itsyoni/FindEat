# Copy to .env.local and fill in real values. Never commit .env.local.

# Base URL of the FindEat backend API
EXPO_PUBLIC_API_URL=

# Mapbox access token used for maps/geo features
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Client-side GIPHY SDK/API key used by chat and comment GIF search
EXPO_PUBLIC_GIPHY_API_KEY=

# OAuth client IDs from Google Cloud/Firebase. The web client ID is also
# configured on the backend as an accepted token audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional when the iOS client ID uses Google's standard format; otherwise set
# the reversed client URL scheme explicitly for the native iOS callback.
GOOGLE_IOS_URL_SCHEME=

# Build variant, e.g. "development" | "preview" | "production"
APP_VARIANT=development
