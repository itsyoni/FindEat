{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.19.27",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:clean": "expo start --dev-client --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "version:check": "node ../../scripts/mobile-version.mjs check",
    "version:patch": "node ../../scripts/mobile-version.mjs patch",
    "version:minor": "node ../../scripts/mobile-version.mjs minor",
    "version:major": "node ../../scripts/mobile-version.mjs major",
    "version:set": "node ../../scripts/mobile-version.mjs set",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:all": "eas build --platform all --profile development",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:all": "eas build --platform all --profile preview",
    "build:prod:ios": "npm run version:check && eas build --platform ios --profile production",
    "build:prod:android": "npm run version:check && eas build --platform android --profile production",
    "build:prod:all": "npm run version:check && eas build --platform all --profile production",
    "build:prod:ios:submit": "npm run version:check && eas build --platform ios --profile production --auto-submit",
    "build:prod:android:submit": "npm run version:check && eas build --platform android --profile production --auto-submit",
    "submit:ios:latest": "eas submit --platform ios --latest",
    "submit:android:latest": "eas submit --platform android --latest"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/roboto-mono": "^0.4.2",
    "@expo-google-fonts/rubik": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@findeat/legal": "*",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@rnmapbox/maps": "^10.2.10",
    "@shopify/react-native-skia": "2.6.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.17.0",
    "expo": "~56.0.19",
    "expo-apple-authentication": "~56.0.4",
    "expo-audio": "~56.0.13",
    "expo-blur": "~56.0.4",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.20",
    "expo-dev-client": "~56.0.24",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.24",
    "expo-image-picker": "~56.0.23",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-location": "~56.0.23",
    "expo-media-library": "~56.0.10",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.21",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.6",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.3.4",
    "nativewind": "^5.0.0-preview.4",
    "phosphor-react-native": "^3.0.6",
    "postcss": "^8.5.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-heroicons": "^4.0.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "socket.io-client": "^4.7.5",
    "tailwindcss": "^4.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "private": true
}
